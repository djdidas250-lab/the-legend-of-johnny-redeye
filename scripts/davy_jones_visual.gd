extends Sprite2D
## Davy Jones' frame-aligned animation strips are generated by tools/prepare_davy_jones.py.
const FRAME_SIZE := Vector2i(320, 384)
const SHEETS := {
	"side_walk": preload("res://images/sprites/davy_human_walk.png"),
	"human_attack": preload("res://images/sprites/davy_human_attack.png"),
	"human_fall": preload("res://images/sprites/davy_human_fall.png"),
	"entrance": preload("res://images/sprites/davy_human_entrance.png"),
	"transformation": preload("res://images/sprites/davy_transformation.png"),
	"octopus_walk": preload("res://images/sprites/davy_octopus_walk.png"),
	"octopus_walk_down": preload("res://images/sprites/davy_octopus_walk_down.png"),
	"octopus_transition": preload("res://images/sprites/davy_octopus_transition.png"),
	"octopus_walk_up": preload("res://images/sprites/davy_octopus_walk_up.png"),
	"octopus_idle": preload("res://images/sprites/davy_octopus_idle.png"),
	"octopus_attack": preload("res://images/sprites/davy_octopus_attack.png")
}
var FRAME_COUNTS := {}
var animation_name := "side_walk"
var frame_index := 0
var frame_timer := 0.0
var frame_rate := 9.0
var looping := true
var finished := false
var base_scale := Vector2.ONE
var base_position := Vector2.ZERO
const OCTOPUS_FORM_SCALE := 1.0

func _ready() -> void:
	base_scale = scale
	base_position = position
	centered = true
	region_enabled = true
	texture = SHEETS[animation_name]
	for animation in SHEETS:
		FRAME_COUNTS[animation] = maxi(1, int(SHEETS[animation].get_width() / FRAME_SIZE.x))
	_apply_frame()

func play_animation(name: String, fps: float = 9.0, loop: bool = true) -> void:
	if animation_name == name and looping == loop and not finished:
		return
	if not SHEETS.has(name):
		push_warning("Unknown Davy Jones animation: " + name)
		return
	animation_name = name
	# The new directional octopus cells share the transformation's normalized
	# scale, keeping the final-form handoff consistent in size.
	var form_scale := OCTOPUS_FORM_SCALE if name in ["octopus_walk", "octopus_walk_down", "octopus_walk_up", "octopus_transition", "octopus_idle", "octopus_attack"] else 1.0
	scale = base_scale * form_scale
	# Scale around the feet rather than the canvas centre so the larger final
	# form stays planted on the same street-depth line.
	position = base_position + Vector2(0.0, -FRAME_SIZE.y * base_scale.y * (form_scale - 1.0) * 0.5)
	frame_index = 0
	frame_timer = 0.0
	frame_rate = maxf(1.0, fps)
	looping = loop
	finished = false
	texture = SHEETS[name]
	_apply_frame()

func _process(delta: float) -> void:
	if finished:
		return
	frame_timer += delta
	var frame_duration := 1.0 / frame_rate
	while frame_timer >= frame_duration:
		frame_timer -= frame_duration
		frame_index += 1
		var count: int = FRAME_COUNTS[animation_name]
		if frame_index >= count:
			if looping:
				frame_index = 0
			else:
				frame_index = count - 1
				finished = true
		_apply_frame()

func transition_to_animation(name: String, fps: float = 9.0, loop: bool = true, fade_seconds: float = 0.24) -> void:
	if not SHEETS.has(name):
		push_warning("Unknown Davy Jones animation: " + name)
		return
	# Keep the final transformation pose visible while the first octopus pose
	# fades in. Both registered frames share the same ground baseline.
	var old_pose := Sprite2D.new()
	old_pose.texture = texture
	old_pose.region_enabled = region_enabled
	old_pose.region_rect = region_rect
	old_pose.centered = centered
	old_pose.position = position
	old_pose.scale = scale
	old_pose.flip_h = flip_h
	old_pose.z_index = z_index + 1
	get_parent().add_child(old_pose)
	play_animation(name, fps, loop)
	modulate = Color(1, 1, 1, 0)
	var blend := get_tree().create_tween()
	blend.set_parallel(true)
	blend.tween_property(self, "modulate:a", 1.0, fade_seconds)
	blend.tween_property(old_pose, "modulate:a", 0.0, fade_seconds)
	blend.chain().tween_callback(old_pose.queue_free)

func _apply_frame() -> void:
	region_rect = Rect2i(frame_index * FRAME_SIZE.x, 0, FRAME_SIZE.x, FRAME_SIZE.y)

func is_animation_finished() -> bool:
	return finished
